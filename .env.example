# Delhi AQI Prediction — environment configuration example
# Copy this file to .env only for local development. Do not commit .env.
# Render environment variables are configured in the Render dashboard or
# render.yaml envVars; the real DATA_GOV_IN_API_KEY is added there.

# Application
APP_NAME="Delhi AQI Prediction"
APP_VERSION="1.0.0"
DEBUG=false

# Delhi NCT location used for weather and external AQI lookups
CITY_NAME="Delhi"
LATITUDE=28.6139
LONGITUDE=77.2090
TIMEZONE="Asia/Kolkata"

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Cache duration (seconds)
CACHE_EXPIRY_SECONDS=1800

# Required only for the live station-observations panel.
# Get a free key from https://www.data.gov.in/ and set it in Render env vars.
DATA_GOV_IN_API_KEY=
